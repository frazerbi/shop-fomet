{
	"version": 2,
	"settings": {
		"appearanceTools": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "name": "Shadow Gray",  "slug": "shadow-gray",  "color": "#282828" },
				{ "name": "Gray dark",    "slug": "gray-dark",     "color": "#4A4A4A" },
				{ "name": "Gray medium",  "slug": "gray-medium",   "color": "#898989" },
				{ "name": "Gray light",   "slug": "gray-light",    "color": "#C8C8C8" },
				{ "name": "Gray pale",    "slug": "gray-pale",     "color": "#EDEDED" },
				{ "name": "White smoke",    "slug": "white-smoke",    "color": "#F4F4F4" },
				{ "name": "Alabaster Gray", "slug": "alabaster-gray", "color": "#F2F0E6" },
				{ "name": "White",          "slug": "white",          "color": "#FFFFFF" },
				{ "name": "Muted Teal",     "slug": "muted-teal",     "color": "#A8C6AC" },
				{ "name": "Dark Teal",    "slug": "dark-teal",     "color": "#5A8A60" },
				{ "name": "Flag Red",     "slug": "flag-red",      "color": "#D21D22" },
				{ "name": "Muted Red",    "slug": "muted-red",     "color": "#B85450" },
				{ "name": "Bright Green", "slug": "bright-green",  "color": "#179d38" }
			],
			"gradients": [
				{
					"name": "Brand Gradient",
					"slug": "brand-gradient",
					"gradient": "linear-gradient(135deg, #243760 0%, #6C9DD9 100%)"
				},
				{
					"name": "Teal Fade",
					"slug": "teal-fade",
					"gradient": "linear-gradient(135deg, #5A8A60 0%, #A8C6AC 100%)"
				},
				{
					"name": "Light to White",
					"slug": "light-to-white",
					"gradient": "linear-gradient(180deg, #F4F4F4 0%, #FFFFFF 100%)"
				}
			]
		},
		"typography": {
			"customFontSize": false,
            "lineHeight": false,
            "dropCap": false,
            "fontStyle": false,
            "fontWeight": false,
            "letterSpacing": false,
            "textDecoration": false,
            "textTransform": false,
			"fontSizes": [
				{ "name": "Extra Small", "slug": "extra-small", "size": "1.5rem" },
				{ "name": "Small",       "slug": "small",       "size": "1.6rem" },
				{ "name": "Normal",       "slug": "normal",       "size": "1.7rem" },
				{ "name": "Normal Large", "slug": "normal-large", "size": "clamp(2.5rem, calc(2.5rem + 23vw / 144), 3rem)" },
				{ "name": "Medium",       "slug": "medium",       "size": "clamp(2.5rem, calc(2.5rem + 90vw / 144), 4.5rem)" },
				{ "name": "Large",       "slug": "large",       "size": "clamp(3.2rem, calc(3.2rem + 250vw / 144), 6rem)" },
				{ "name": "Extra Large", "slug": "extra-large",  "size": "clamp(2.2rem, calc(2.2rem + 500vw / 144), 8rem)" }
			],
			"fontFamilies": [
				{
					"name": "Primary",
					"slug": "primary",
					"fontFamily": "Sora, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Sora",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/sora-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Sora",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/sora-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			]
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"units": ["%", "rem"],
			"spacingSizes": [
				{ "name": "XS",  "slug": "20", "size": "clamp(0.4rem, 0.08rem + 0.32vw, 0.6rem)" },
				{ "name": "S",   "slug": "30", "size": "clamp(0.75rem, -0.05rem + 0.81vw, 1.25rem)" },
				{ "name": "M",   "slug": "40", "size": "clamp(1.1rem, -0.19rem + 1.3vw, 1.9rem)" },
				{ "name": "L",   "slug": "50", "size": "clamp(1.9rem, -0.03rem + 1.95vw, 3.1rem)" },
				{ "name": "XL",  "slug": "60", "size": "clamp(3rem, -0.22rem + 3.25vw, 5rem)" },
				{ "name": "2XL", "slug": "70", "size": "clamp(4.5rem, -0.33rem + 4.87vw, 7.5rem)" },
				{ "name": "3XL", "slug": "80", "size": "clamp(6rem, -0.44rem + 6.49vw, 9rem)" }
			]
		},
		"layout": {
			"contentSize": "72rem",
			"wideSize": "144rem"
		}
	},
	"styles": {
		"elements": {
			"h1": { "typography": { "fontFamily": "var(--font-family-primary)" } },
			"h2": { "typography": { "fontFamily": "var(--font-family-primary)" } },
			"link": { "color": { "text": "var(--color-primary)" } },
			"button": {
				"spacing": {
					"margin": { "top": "0", "bottom": "0", "left": "0", "right": "0" }
				}
			}
		},
		"spacing": {
			"margin": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		},
   		"blocks": {
			"core/paragraph": {
				"spacing": {
					"margin": { "top": "0", "bottom": "0", "left": "0", "right": "0" }
				}
			},
			"core/heading": {
				"spacing": {
					"margin": { "top": "0", "bottom": "0", "left": "0", "right": "0" }
				}
			},
			"core/list": {
				"spacing": {
					"margin": { "top": "0", "bottom": "0", "left": "0", "right": "0" }
				}
			},
			"core/group": {
				"spacing": {
					"margin": { "top": "0", "bottom": "0", "left": "0", "right": "0" }
				}
			},

			"core/column": {
				"spacing": {
					"margin": { "top": "0", "bottom": "0", "left": "0", "right": "0" }
				}
			},
			"core/quote": {
				"spacing": {
					"margin": { "top": "0", "bottom": "0", "left": "0", "right": "0" }
				}
			},
			"core/image": {
				"spacing": {
					"margin": { "top": "0", "bottom": "0", "left": "0", "right": "0" }
				}
			}
		}
	},
	"custom": {
		"layout": {
			"disableContentMargins": true
		}
	},
	"customTemplates": [],
  	"templateParts": []
